{
  "name": "dsh-skin-studio",
  "version": "1.0.1",
  "description": "A local token-safe DSH theme generator, editor, auditor, and exporter",
  "type": "module",
  "main": "./packages/dsh-skin-studio/lib/index.js",
  "types": "./packages/dsh-skin-studio/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/dsh-skin-studio/lib/index.d.ts",
      "default": "./packages/dsh-skin-studio/lib/index.js"
    },
    "./client": {
      "types": "./packages/dsh-skin-studio/lib/client.d.ts",
      "default": "./packages/dsh-skin-studio/lib/client.js"
    },
    "./typert": {
      "types": "./packages/dsh-skin-studio/lib/typert.host.d.ts",
      "default": "./packages/dsh-skin-studio/lib/typert.host.js"
    },
    "./remote": {
      "types": "./packages/dsh-skin-studio/lib/typert.remote-client.d.ts",
      "default": "./packages/dsh-skin-studio/lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./packages/dsh-skin-studio/lib/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "packages/dsh-skin-studio/lib/*.js",
    "packages/dsh-skin-studio/lib/*.d.ts",
    "packages/dsh-skin-studio/lib/*.js.map",
    "packages/dsh-skin-studio/lib/*.d.ts.map",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "docs/WINDOWS_DSH_0.1.2_ACCEPTANCE.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.2-rc.1 <0.1.3-0",
      "dshReleases": {
        "0.1.2-rc.1": "compatible"
      },
      "profiles": [
        "web"
      ]
    }
  },
  "scripts": {
    "build": "corepack pnpm run build:host && corepack pnpm run build:client",
    "build:host": "corepack pnpm --dir packages/dsh-skin-studio run build:host",
    "build:client": "corepack pnpm --dir packages/dsh-skin-studio run build:client",
    "clean": "corepack pnpm --dir packages/dsh-skin-studio run clean",
    "typecheck": "corepack pnpm --dir packages/dsh-skin-studio run typecheck",
    "test": "vitest run",
    "pack:check": "node scripts/verify-package.mjs && npm pack --dry-run",
    "prepack": "node scripts/verify-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeemanCheung/dsh-skin-studio.git"
  },
  "bugs": {
    "url": "https://github.com/LeemanCheung/dsh-skin-studio/issues"
  },
  "homepage": "https://github.com/LeemanCheung/dsh-skin-studio#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-remotes": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-storage": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.2-rc.1",
    "react": "^18.2.0"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-generator": "0.1.2-rc.1",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-remotes": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-storage": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.2-rc.1",
    "react": "^18.2.0"
  }
}
